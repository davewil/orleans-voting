@using Orleans.Configuration
@using Microsoft.Extensions.Options
@inherits LayoutComponentBase
@inject IOptions<ClusterOptions> ClusterOptions

<PageTitle>Grain Poll</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<footer class="mt-auto border bg-light">
    <h4 class="text-dark text-center pt-3">Client connected to cluster <span class="text-success">@ClusterOptions.Value.ClusterId</span></h4>
    <p class="text-center text-muted pb-3">(Service is running as an Orleans client; no local silo)</p>
</footer>
